            "A fishing game",
            "Tricking you into revealing sensitive info",
            "Fixing a computer bug",
            "Upgrading software"
        ],
        1
    ],

    [
        "Which of these is a sign of a fake website?",
        [
            "Poor spelling/grammar & strange URL",
            "A valid padlock icon",
            "Clear customer service number",
            "Fast loading speed"
        ],
        0
    ],

    [
        "What does 'https' indicate in a web URL?",
        [
