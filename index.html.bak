        [
            "A deep dive into AI algorithms",
            "AI-generated fake audio, video, or photo impersonating real people",
            "A strong encrypted password",
            "A secure operating system"
        ],
        1
    ]

];


let questionIndex = 0;
let score = 0;


function renderQuestion(){

    const question =
        questions[questionIndex];


    $("#qText").textContent =
        (questionIndex + 1)
        + ". "
        + question[0];


    $("#qOptions").innerHTML =
        question[1]
        .map(function(option,index){

            return `
                <label>
                    <input
                        type="radio"
                        name="q"
                        value="${index}"
                    >
                    ${option}
                </label>
            `;

        })
        .join("");


    $("#nextQ").textContent =
        questionIndex === questions.length - 1
        ?
        "Finish Quiz"
        :
        "Next Question →";

}


$("#nextQ").addEventListener(
    "click",
    function(){

        const answer =
            document.querySelector(
                'input[name="q"]:checked'
            );


        if(!answer){

            alert(
                "Please select an answer."
            );

            return;

        }


        if(
            +answer.value
            ===
            questions[questionIndex][2]
        ){

            score++;

        }


        if(
            questionIndex
            <
            questions.length - 1
        ){

            questionIndex++;

            renderQuestion();

        }else{

            $("#qText").textContent =
                "Quiz completed!";


            $("#qOptions").innerHTML =
                "";


            $("#nextQ").style.display =
                "none";


            $("#quizResult").innerHTML = `

                <div class="quizResult">

                    Your score:
                    ${score}/${questions.length}

                    —

                    ${
                        score >= 15
                        ?
                        "🏆 Outstanding! You are a Cyber Safety Champion!"
                        :
                        score >= 10
                        ?
                        "👍 Good effort! Review the learning modules to boost your score."
                        :
                        "⚠️ Keep learning and try the quiz again to stay protected."
                    }

                </div>

            `;

        }

    }
);


renderQuestion();

</script>

</body>
</html>