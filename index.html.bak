        <input
            id="pwdInput"
            type="password"
            placeholder="Type a password"
        >

        <button id="showPwd">
            Show
        </button>


        <div class="meter">
            <i id="pwdBar"></i>
        </div>


        <h3 id="pwdResult">
            Start typing to check strength
        </h3>


        <ul id="pwdRules">

            <li>
                At least 8 characters
            </li>

            <li>
                Uppercase and lowercase letters
            </li>

            <li>
                A number
            </li>

            <li>
                A special character
            </li>

        </ul>

    </div>

</section>


