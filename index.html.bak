<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>DigitalShield | Cyber Safety Dashboard</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Inter,Arial,sans-serif;
    background:#eef8ff;
    color:#234b70;
    min-height:100vh;
}

.bg-grid{
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:-5;

    background-image:
        linear-gradient(rgba(55,145,210,.045) 1px,transparent 1px),
        linear-gradient(90deg,rgba(55,145,210,.045) 1px,transparent 1px);

    background-size:45px 45px;
}

.glow{
    position:fixed;
    width:350px;
    height:350px;
    border-radius:50%;
    filter:blur(90px);
    opacity:.25;
    pointer-events:none;
    z-index:-4;
}

.g1{
    top:-120px;
    left:-100px;
    background:#8ddcff;
}

.g2{
    right:-120px;
    top:35%;
    background:#b8a9ff;
}

.g3{
    bottom:-150px;
    left:35%;
    background:#8ae8df;
}


/* =========================================================
   LOGIN SCREEN
   ========================================================= */

.login-screen{
    position:fixed;
    inset:0;
    z-index:99999;

    display:flex;
    align-items:center;
    justify-content:center;

    background:
        radial-gradient(circle at 20% 20%,rgba(100,200,255,.22),transparent 30%),
        radial-gradient(circle at 80% 70%,rgba(130,100,255,.18),transparent 30%),
        #eaf7ff;

    padding:20px;
}

.login-box{
    width:100%;
    max-width:430px;

    padding:38px 34px;

    border-radius:25px;

    background:rgba(255,255,255,.94);

    border:1px solid #cce8f8;

    box-shadow:
        0 25px 70px rgba(50,120,180,.18);

    text-align:center;
}

.login-logo{
    width:75px;
    height:75px;

    margin:0 auto 18px;

    border-radius:22px;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:38px;

    color:white;

    background:linear-gradient(135deg,#2584c8,#7767e8);

    box-shadow:0 12px 30px rgba(70,130,220,.25);
}

.login-box h1{
    font-size:31px;
    color:#234e78;
    margin-bottom:5px;
}

.login-box h1 span{
    color:#5e6fe7;
}

.login-subtitle{
    color:#7895ad;
    font-size:13px;
    margin-bottom:28px;
}

.login-form{
    text-align:left;
}

.login-form label{
    display:block;
    color:#527492;
    font-size:12px;
    font-weight:700;
    margin:0 0 7px;
}

.login-form input{
    width:100%;
    height:48px;

    border:1px solid #cfe5f3;
    border-radius:12px;

    padding:0 14px;

    outline:none;

    background:#f7fcff;
    color:#234b70;

    margin-bottom:15px;

    font-size:14px;
}

.login-form input:focus{
    border-color:#6baee0;
    box-shadow:0 0 0 3px rgba(80,160,220,.10);
}

.password-box{
    position:relative;
}

.password-box input{
    padding-right:65px;
}

.password-box button{
    position:absolute;
    right:7px;
    top:5px;

    height:38px;

    border:0;
    border-radius:9px;

    padding:0 11px;

    cursor:pointer;

    color:#4d78a0;
    background:#eaf6ff;
}

.login-btn{
    width:100%;
    height:49px;

    border:0;
    border-radius:13px;

    cursor:pointer;

    color:white;
    font-weight:800;
    font-size:14px;

    background:linear-gradient(135deg,#328bc9,#6d68e7);

    box-shadow:0 10px 25px rgba(70,120,210,.22);

    transition:.2s;
}

.login-btn:hover{
    transform:translateY(-2px);
}

#loginMessage{
    text-align:center;
    min-height:20px;
    margin-top:13px;
    font-size:12px;
    font-weight:700;
}

.login-footer{
    margin-top:25px;
    padding-top:18px;

    border-top:1px solid #e2eff7;

    color:#91aabd;
    font-size:11px;
}


/* =========================================================
   TOPBAR
   ========================================================= */

.topbar{
    height:78px;

    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:0 28px;

    background:rgba(255,255,255,.86);

    border-bottom:1px solid #d6ebf7;

    box-shadow:0 5px 25px rgba(60,130,180,.06);

    position:sticky;
    top:0;
    z-index:1000;

    backdrop-filter:blur(15px);
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;
}

.logo-shield{
    width:43px;
    height:43px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:13px;

    color:white;

    background:linear-gradient(135deg,#318bc9,#7067e8);

    font-size:22px;
    font-weight:900;
}

.brand h1{
    color:#24527d;
    font-size:21px;
}

.brand h1 span{
    color:#6570e5;
}

.brand p{
    color:#8aa3b7;
    font-size:10px;
    margin-top:2px;
}

.topnav{
    display:flex;
    gap:4px;
}

.top-link{
    border:0;
    background:transparent;

    color:#64839e;

    padding:10px 12px;

    border-radius:10px;

    cursor:pointer;

    font-size:12px;
}

.top-link:hover,
.top-link.active{
    background:#e8f5fd;
    color:#347bb0;
}

.profile{
    display:flex;
    align-items:center;
    gap:10px;
}

.theme{
    display:flex;
    gap:4px;
}

.theme button{
    width:34px;
    height:34px;

    border:1px solid #d6eaf5;

    background:#f4fbff;

    border-radius:9px;

    cursor:pointer;
}

.avatar{
    width:38px;
    height:38px;

    border-radius:50%;

    display:flex;
    align-items:center;
    justify-content:center;

    background:#dceeff;
    color:#397ab0;

    font-weight:800;
}

.profile b{
    display:block;
    color:#365d7e;
    font-size:12px;
}

.profile small{
    color:#7f9bad;
    font-size:10px;
}

.profile small i{
    display:inline-block;
    width:6px;
    height:6px;
    border-radius:50%;
    background:#31bf91;
    margin-right:4px;
}

.drop{
    border:0;
    background:transparent;
    color:#66859f;
    cursor:pointer;
}

.hamb{
    display:none;
    border:0;
    background:transparent;
    font-size:23px;
    cursor:pointer;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

.sidebar{
    position:fixed;
    top:78px;
    left:0;
    bottom:0;

    width:225px;

    padding:20px 13px;

    background:rgba(250,253,255,.94);

    border-right:1px solid #d8edf7;

    z-index:900;
}

.side-link{
    width:100%;

    display:flex;
    align-items:center;
    gap:12px;

    border:0;
    background:transparent;

    color:#66849d;

    padding:12px 14px;

    margin-bottom:5px;

    border-radius:11px;

    cursor:pointer;

    text-align:left;

    font-size:12px;
    font-weight:600;

    transition:.2s;
}

.side-link span{
    width:20px;
    text-align:center;
}

.side-link:hover,
.side-link.active{
    background:#e5f4fc;
    color:#2879b4;
}

.side-bottom{
    position:absolute;
    left:13px;
    right:13px;
    bottom:20px;
}

.side-bottom p{
    color:#9ab0c0;
    font-size:10px;
    line-height:1.6;
    padding:15px;
}


/* =========================================================
   MAIN
   ========================================================= */

.main{
    margin-left:225px;
    padding:30px;
    min-height:calc(100vh - 78px);
}

.page{
    display:none;
}

.page.active{
    display:block;
}

.page-title{
    margin-bottom:25px;
}

.page-title h2{
    color:#285681;
    font-size:27px;
    margin-bottom:6px;
}

.page-title p{
    color:#7d99ad;
    font-size:13px;
}


/* =========================================================
   CARDS
   ========================================================= */

.card,
.tool-card,
.info,
.module{
    background:rgba(255,255,255,.91);

    border:1px solid #d4eaf5;

    border-radius:18px;

    box-shadow:
        0 12px 35px rgba(60,130,180,.07);
}


/* =========================================================
   DASHBOARD
   ========================================================= */

.dashboard-grid{
    display:grid;
    grid-template-columns:minmax(0,1fr) 320px;
    gap:24px;
}

.center-col,
.right-col{
    min-width:0;
}

.welcome{
    min-height:220px;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:28px;

    overflow:hidden;
}

.welcome-text small{
    color:#4d96c8;
    font-size:11px;
}

.welcome h2{
    color:#2d5a80;
    font-size:28px;
    margin:10px 0 5px;
}

.welcome p{
    color:#7995a9;
    font-size:13px;
}

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;

    margin-top:25px;
}

.stats div{
    background:#f1f9fe;
    border:1px solid #dceef7;

    padding:11px;

    border-radius:11px;
}

.stats b,
.stats small{
    display:block;
}

.stats b{
    color:#3c6e94;
    font-size:14px;
    margin-top:3px;
}

.stats small{
    color:#8ba3b4;
    font-size:9px;
    margin-top:3px;
}

.stats em{
    display:block;
    width:7px;
    height:7px;
    border-radius:50%;
    background:#35bf91;
}

.hero-shield{
    width:180px;
    height:180px;

    display:flex;
    align-items:center;
    justify-content:center;

    position:relative;
}

.network{
    position:absolute;
    width:155px;
    height:155px;
    border-radius:50%;
    border:1px dashed #9bd5ee;
}

.big-shield{
    width:95px;
    height:110px;

    display:flex;
    align-items:center;
    justify-content:center;

    background:linear-gradient(145deg,#dff4ff,#dfe1ff);

    clip-path:polygon(
        50% 0,
        90% 18%,
        90% 58%,
        75% 80%,
        50% 100%,
        25% 80%,
        10% 58%,
        10% 18%
    );

    color:#5d70e0;
    font-size:35px;
    font-weight:900;

    box-shadow:0 15px 30px rgba(60,130,220,.15);
}


/* =========================================================
   SECTION HEAD
   ========================================================= */

.section-head{
    margin:27px 0 16px;
}

.section-head h2{
    color:#315d82;
    font-size:20px;
}

.section-head h2 span{
    color:#6570e4;
}

.section-head p{
    color:#809bad;
    font-size:12px;
    margin-top:5px;
}


/* =========================================================
   TOOLS
   ========================================================= */

.tools-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:16px;
}

.tool-card{
    padding:21px;
    transition:.2s;
}

.tool-card:hover{
    transform:translateY(-3px);
}

.tool-icon{
    width:45px;
    height:45px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:12px;

    margin-bottom:14px;

    font-size:21px;
}

.tool-icon.purple{
    background:#eeeaff;
    color:#7064dc;
}

.tool-icon.blue{
    background:#e4f4ff;
    color:#3989c6;
}

.tool-icon.green{
    background:#e5faf4;
    color:#38a985;
}

.tool-icon.violet{
    background:#f0eaff;
    color:#765ad8;
}

.tool-card h3{
    color:#315b7d;
    font-size:16px;
    margin-bottom:8px;
}

.tool-card p{
    color:#7c98ab;
    font-size:11px;
    line-height:1.6;
}

.tool-card button,
.module button,
.promo button{
    border:0;
    background:transparent;

    color:#3b85ba;

    cursor:pointer;

    margin-top:15px;

    font-size:11px;
    font-weight:800;
}


/* =========================================================
   SCAM ROW
   ========================================================= */

.scam-row{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
}

.scam-row article{
    padding:15px;

    border-radius:13px;

    background:#f8fcff;

    border:1px solid #dceef7;
}

.scam-row article b{
    display:block;
    margin-bottom:8px;
}

.scam-row strong{
    display:block;
    color:#416987;
    font-size:12px;
}

.scam-row a{
    display:inline-block;
    color:#438bc0;
    font-size:10px;
    margin-top:8px;
    cursor:pointer;
}


/* =========================================================
   QUOTE
   ========================================================= */

.quote{
    display:flex;
    align-items:center;
    gap:15px;

    margin-top:18px;

    padding:20px;
}

.quote b{
    color:#426b88;
    font-size:14px;
}

.quote p{
    color:#8ba2b2;
    font-size:11px;
    margin-top:5px;
}


/* =========================================================
   RIGHT COLUMN
   ========================================================= */

.score-card{
    padding:23px;
}

.score-card h2,
.tips h2{
    color:#345e7d;
    font-size:17px;
    margin-bottom:18px;
}

.score-flex{
    display:flex;
    align-items:center;
    gap:20px;
}

.ring{
    width:105px;
    height:105px;

    flex-shrink:0;

    border-radius:50%;

    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;

    background:
        radial-gradient(circle,#fff 58%,transparent 59%),
        conic-gradient(#5d9fca 0 78%,#dcecf4 78%);

}

.ring strong{
    color:#315e82;
    font-size:25px;
}

.ring small{
    color:#91a7b5;
    font-size:9px;
}

.ring b{
    color:#35a782;
    font-size:10px;
}

.score-flex ul{
    list-style:none;
}

.score-flex li{
    display:flex;
    gap:7px;

    color:#3eaf8d;

    font-size:10px;

    margin-bottom:10px;
}

.score-flex li span{
    color:#7895a9;
}

.primary{
    width:100%;

    border:0;
    border-radius:10px;

    padding:12px;

    background:linear-gradient(135deg,#398fc7,#7068e5);

    color:white;

    cursor:pointer;

    font-size:11px;
    font-weight:800;
}

.score-card .primary{
    margin-top:20px;
}

.tips{
    padding:22px;
    margin-top:17px;
}

.tips p{
    color:#7895a9;
    font-size:11px;
    margin:12px 0;
}

.promo{
    padding:24px;

    margin-top:17px;

    border-radius:18px;

    background:linear-gradient(135deg,#e5f6ff,#eae8ff);

    border:1px solid #d6e6f5;
}

.promo h2{
    color:#3c6280;
    font-size:17px;
    margin:12px 0;
}

.promo h2 span{
    color:#706be0;
}


/* =========================================================
   LEARNING MODULES
   ========================================================= */

.module-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:16px;
}

.module{
    padding:22px;
}

.module > span{
    font-size:28px;
}

.module h3{
    color:#345e7d;
    font-size:16px;
    margin:13px 0 7px;
}

.module p{
    color:#7c98ab;
    font-size:11px;
    line-height:1.6;
}


/* =========================================================
   CHECKERS
   ========================================================= */

.checker{
    padding:25px;
    max-width:850px;
}

.checker input,
.checker textarea{
    width:100%;

    border:1px solid #d0e7f4;
    border-radius:12px;

    background:#f8fcff;

    color:#315b7d;

    outline:none;

    padding:14px;

    font-size:13px;
}

.checker textarea{
    min-height:180px;
    resize:vertical;
}

.checker input:focus,
.checker textarea:focus{
    border-color:#76b5db;
}

#showPwd{
    margin-top:10px;

    border:1px solid #d4e8f3;
    background:#edf8ff;

    color:#5180a1;

    padding:9px 14px;

    border-radius:9px;

    cursor:pointer;
}

.meter{
    height:10px;

    margin-top:18px;

    border-radius:10px;

    background:#e2eff6;

    overflow:hidden;
}

.meter i{
    display:block;
    width:0;
    height:100%;

    background:linear-gradient(90deg,#ee8790,#e7ba62,#45b991);

    transition:.3s;
}

#pwdResult{
    color:#416987;
    margin-top:15px;
}

#pwdRules{
    margin-top:15px;
    padding-left:20px;

    color:#7895a9;

    font-size:12px;

    line-height:1.8;
}

.checker .primary{
    margin-top:15px;
    max-width:200px;
}

.result{
    display:none;

    margin-top:17px;

    padding:15px;

    border-radius:12px;

    background:#eef9ff;

    border:1px solid #d6edf7;

    color:#527792;

    font-size:12px;

    line-height:1.6;
}

.result.show{
    display:block;
}


/* =========================================================
   SOCIAL / INFO
   ========================================================= */

.info-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:18px;
}

.info{
    padding:23px;
}

.info > div:first-child{
    font-size:32px;
}

.info h3{
    color:#345e7d;
    font-size:17px;
    margin:12px 0 7px;
}

.info p{
    color:#7c98ab;
    font-size:12px;
    line-height:1.65;
}


/* =========================================================
   UPDATED SCAM AWARENESS
   ========================================================= */

.scam-info-card{
    position:relative;
    overflow:hidden;

    min-height:485px;

    padding:22px;
}

.scam-image,
.card-banner{
    width:100%;
    height:160px;
    border-radius:16px;
    overflow:hidden;
    margin-bottom:17px;
    border:1px solid #cce6f5;
    background:#0f172a;
    display:block;
}

.scam-image img,
.card-banner img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
}

.scam-tag{
    display:inline-block;

    padding:5px 9px;

    border-radius:20px;

    font-size:9px;
    font-weight:800;

    margin-bottom:9px;
}

.scam-tag.red{
    color:#df4b62;
    background:#fff0f3;
}

.scam-tag.orange{
    color:#c98916;
    background:#fff5df;
}

.scam-tag.pink{
    color:#df5275;
    background:#fff0f4;
}

.scam-tag.yellow{
    color:#bd850c;
    background:#fff6df;
}

.scam-info-card h3{
    color:#2f5b7d;
    font-size:18px;
    margin-bottom:9px;
}

.scam-info-card p{
    color:#7592a7;
    font-size:11px;
    line-height:1.6;
}

.scam-info-card ul{
    list-style:none;
    margin:16px 0;

    display:flex;
    flex-direction:column;
    gap:8px;
}

.scam-info-card li{
    color:#567c97;
    font-size:11px;
    line-height:1.45;
}

.how-protect{
    padding:12px;

    border-radius:11px;

    background:#eef9ff;

    border:1px solid #d7edf7;

    color:#64839a;

    font-size:10px;
    line-height:1.55;
}

.how-protect b{
    color:#327ab0;
}


/* =========================================================
   SAFETY BOX
   ========================================================= */

.scam-safety-box{
    display:flex;
    align-items:center;
    gap:18px;

    margin-top:20px;

    padding:22px;

    border-radius:17px;

    background:linear-gradient(135deg,#edf9ff,#eaeaff);

    border:1px solid #d4eaf6;
}

.scam-safety-icon{
    width:55px;
    height:55px;

    flex-shrink:0;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:15px;

    background:#dceeff;

    font-size:27px;
}

.scam-safety-box h3{
    color:#315d7e;
    font-size:17px;
    margin-bottom:5px;
}

.scam-safety-box p{
    color:#7a97aa;
    font-size:11px;
    margin-bottom:5px;
}

.scam-safety-box strong{
    color:#397fb3;
    font-size:11px;
}


/* REPORT */

.scam-report-box{
    margin-top:18px;

    padding:22px;

    border-radius:17px;

    background:linear-gradient(135deg,#fff4f6,#edf7ff);

    border:1px solid #f0d8de;
}

.scam-report-box h3{
    color:#3a607c;
    font-size:17px;
    margin-bottom:7px;
}

.scam-report-box p{
    color:#7895a8;
    font-size:11px;
    line-height:1.6;
}

.report-number{
    display:inline-block;

    margin-top:14px;

    padding:9px 17px;

    border-radius:10px;

    background:white;

    border:1px solid #f1d5dc;

    color:#dd536b;

    font-size:19px;
    font-weight:800;
}

.scam-report-box small{
    margin-left:9px;
    color:#819aaa;
}


/* =========================================================
   SCORE PAGE
   ========================================================= */

.big-score{
    padding:35px;

    display:flex;
    align-items:center;

    gap:35px;
}

.ring.large{
    width:180px;
    height:180px;
}

.big-score h3{
    color:#355f7e;
    margin-bottom:8px;
}

.big-score p{
    color:#7895a8;
    font-size:12px;
    line-height:1.6;
    margin-bottom:15px;
}


/* =========================================================
   QUIZ
   ========================================================= */

.quiz{
    max-width:850px;
    padding:27px;
}

#qText{
    color:#315d7e;
    font-size:17px;
    font-weight:800;
    margin-bottom:20px;
}

#qOptions{
    display:flex;
    flex-direction:column;
    gap:10px;
}

#qOptions label{
    padding:13px;

    border:1px solid #d6eaf5;

    border-radius:11px;

    background:#f8fcff;

    color:#607f98;

    cursor:pointer;

    font-size:12px;
}

#qOptions label:hover{
    background:#eef8ff;
}

#qOptions input{
    margin-right:8px;
}

#nextQ{
    margin-top:18px;
    max-width:190px;
}

.quizResult{
    margin-top:18px;

    padding:15px;

    border-radius:12px;

    background:#eef9ff;

    color:#3d7193;

    font-weight:700;
}


/* =========================================================
   FOOTER
   ========================================================= */

footer{
    margin-left:225px;

    padding:22px 30px;

    border-top:1px solid #d9edf7;

    color:#91a8b7;

    font-size:10px;

    text-align:center;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media(max-width:1100px){

    .topnav{
        display:none;
    }

    .dashboard-grid{
        grid-template-columns:1fr;
    }

    .right-col{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:15px;
    }

    .right-col .promo{
        grid-column:1/-1;
        margin-top:0;
    }

}

@media(max-width:850px){

    .sidebar{
        transform:translateX(-100%);
        transition:.25s;
    }

    .sidebar.open{
        transform:translateX(0);
    }

    .main,
    footer{
        margin-left:0;
    }

    .hamb{
        display:block;
    }

    .profile{
        margin-left:auto;
        margin-right:10px;
    }

    .profile > div:not(.avatar):not(.theme){
        display:none;
    }

    .tools-grid,
    .module-grid,
    .info-grid{
        grid-template-columns:1fr;
    }

    .scam-row{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:600px){

    .topbar{
        padding:0 14px;
        height:68px;
    }

    .sidebar{
        top:68px;
    }

    .main{
        padding:18px 14px;
    }

    .brand h1{
        font-size:18px;
    }

    .brand p{
        font-size:8px;
    }

    .logo-shield{
        width:38px;
        height:38px;
    }

    .welcome{
        flex-direction:column;
        align-items:flex-start;
        min-height:auto;
    }

    .hero-shield{
        align-self:center;
        margin-top:10px;
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .right-col{
        display:block;
    }

    .right-col > *{
        margin-bottom:15px;
    }

    .scam-row{
        grid-template-columns:1fr;
    }

    .big-score{
        flex-direction:column;
        text-align:center;
    }

    .scam-safety-box{
        align-items:flex-start;
        flex-direction:column;
    }

    .scam-report-box{
        padding:18px;
    }

    .report-number{
        display:block;
        width:max-content;
    }

    .scam-report-box small{
        display:block;
        margin:8px 0 0;
    }

    .login-box{
        padding:30px 22px;
    }

}

</style>
</head>


