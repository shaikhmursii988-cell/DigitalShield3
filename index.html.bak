<section id="quiz" class="page">

    <div class="page-title">

        <h2>
            Safety Quiz
        </h2>

        <p>
            Answer 20 quick awareness questions.
        </p>

    </div>


    <div class="quiz card">

        <div id="qText"></div>

        <div id="qOptions"></div>

        <button
            class="primary"
            id="nextQ"
        >
            Next Question →
        </button>

        <div id="quizResult"></div>

    </div>

</section>


</main>


<!-- =========================================================
     FOOTER
     ========================================================= -->

<footer>

    © 2026 DigitalShield
    &nbsp; • &nbsp;
    Digital Safety Awareness Project

</footer>


<script>

/* =========================================================
   PAGE NAVIGATION
   ========================================================= */

const $ = selector => document.querySelector(selector);
const $$ = selector => document.querySelectorAll(selector);

const pages = [...$$(".page")];


function go(page){

    pages.forEach(p => {

        p.classList.toggle(
            "active",
            p.id === page
        );

    });


    $$("[data-page]").forEach(button => {

        button.classList.toggle(
            "active",
            button.dataset.page === page
        );

    });


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });


    const sidebar = $("#sidebar");

    if(sidebar){
        sidebar.classList.remove("open");
    }

}


/* NAVIGATION BUTTONS */

document.addEventListener("click",function(event){

    const button = event.target.closest("[data-page]");

    if(!button){
        return;
    }

    go(button.dataset.page);

});


/* =========================================================
   HAMBURGER
   ========================================================= */

const hamb = $("#hamb");

if(hamb){

    hamb.addEventListener("click",function(){

        $("#sidebar").classList.toggle("open");

    });

}


/* =========================================================
   THEME BUTTON
   ========================================================= */

const themeBtn = $("#themeBtn");

if(themeBtn){

    themeBtn.addEventListener("click",function(){

        document.body.classList.toggle("light");

    });

}


/* =========================================================
   AUTH (REGISTER & LOGIN)
   ========================================================= */

const registerScreen = $("#registerScreen");
const loginScreen = $("#loginScreen");


/* --- Registration --- */

const regBtn = $("#regBtn");
const regName = $("#regName");
const regEmail = $("#regEmail");
const regPassword = $("#regPassword");
const regMessage = $("#regMessage");

function doRegister(){

    if(
        regName.value.trim() === "" ||
        regEmail.value.trim() === "" ||
        regPassword.value.trim() === ""
    ){

        regMessage.textContent =
            "Please fill out all fields.";

        regMessage.style.color =
            "#df536a";

        return;

    }


    regMessage.textContent =
        "Registration successful! Redirecting to login...";

    regMessage.style.color =
        "#29a77f";


    $("#loginUser").value =
        regEmail.value.trim();


    setTimeout(function(){

        registerScreen.style.display =
            "none";

        loginScreen.style.display =
            "flex";

    },1000);

}


if(regBtn)
    regBtn.addEventListener(
        "click",
        doRegister
    );


if(regPassword){

    regPassword.addEventListener(
        "keydown",
        function(event){

            if(event.key === "Enter")
                doRegister();

        }
    );

}


const showRegPassword =
    $("#showRegPassword");


if(showRegPassword){

    showRegPassword.addEventListener(
        "click",
        function(){

            if(regPassword.type === "password"){

                regPassword.type =
                    "text";

                this.textContent =
                    "Hide";

            }else{

                regPassword.type =
                    "password";

                this.textContent =
                    "Show";

            }

        }
    );

}


const goToLogin =
    $("#goToLogin");


if(goToLogin){

    goToLogin.addEventListener(
        "click",
        function(e){

            e.preventDefault();

            registerScreen.style.display =
                "none";

            loginScreen.style.display =
                "flex";

        }
    );

}


/* --- Login --- */

const loginBtn = $("#loginBtn");
const loginUser = $("#loginUser");
const loginPassword = $("#loginPassword");
const loginMessage = $("#loginMessage");


function doLogin(){

    const username =
        loginUser.value.trim();

    const password =
        loginPassword.value.trim();


    if(username === "" || password === ""){

        loginMessage.textContent =
            "Please enter email and password.";

        loginMessage.style.color =
            "#df536a";

        return;

    }


    loginMessage.textContent =
        "Login successful ✓";

    loginMessage.style.color =
        "#29a77f";


    let displayName =
        username;


    if(username.includes("@")){

        displayName =
            username.split("@")[0];

    }


    if(
        regName &&
        regName.value.trim() !== "" &&
        username === regEmail.value.trim()
    ){

        displayName =
            regName.value.trim().split(" ")[0];

    }


    displayName =
        displayName.charAt(0).toUpperCase()
        +
        displayName.slice(1);


    $("#profileName").textContent =
        displayName;

    $("#helloName").textContent =
        displayName;

    $("#avatar").textContent =
        displayName.charAt(0).toUpperCase();


    setTimeout(function(){

        loginScreen.style.display =
            "none";

        registerScreen.style.display =
            "none";

        document.body.style.overflow =
            "";

    },700);

}


if(loginBtn)
    loginBtn.addEventListener(
        "click",
        doLogin
    );


if(loginPassword){

    loginPassword.addEventListener(
        "keydown",
        function(event){

            if(event.key === "Enter")
                doLogin();

        }
    );

}


const showLoginPassword =
    $("#showLoginPassword");


if(showLoginPassword){

    showLoginPassword.addEventListener(
        "click",
        function(){

            if(loginPassword.type === "password"){

                loginPassword.type =
                    "text";

                this.textContent =
                    "Hide";

            }else{

                loginPassword.type =
                    "password";

                this.textContent =
                    "Show";

            }

        }
    );

}


const goToRegister =
    $("#goToRegister");


if(goToRegister){

    goToRegister.addEventListener(
        "click",
        function(e){

            e.preventDefault();

            loginScreen.style.display =
                "none";

            registerScreen.style.display =
                "flex";

        }
    );

}


/* =========================================================
   LOGOUT
   ========================================================= */

$("#logout").addEventListener(
    "click",
    function(){

        registerScreen.style.display =
            "flex";

        loginScreen.style.display =
            "none";

        loginUser.value =
            "";

        loginPassword.value =
            "";

        loginMessage.textContent =
            "";

        regName.value =
            "";

        regEmail.value =
            "";

        regPassword.value =
            "";

        regMessage.textContent =
            "";

        go("dashboard");

    }
);


/* =========================================================
   PASSWORD CHECKER
   ========================================================= */

const pwd = $("#pwdInput");
const bar = $("#pwdBar");
const res = $("#pwdResult");
const show = $("#showPwd");


function checkPwd(){

    const value =
        pwd.value;

    let strength = 0;


    if(value.length >= 8){
        strength++;
    }


    if(
        /[a-z]/.test(value)
        &&
        /[A-Z]/.test(value)
    ){
        strength++;
    }


    if(/\d/.test(value)){
        strength++;
    }


    if(/[^A-Za-z0-9]/.test(value)){
        strength++;
    }


    if(value.length >= 14){
        strength++;
    }


    bar.style.width =
        (strength * 20) + "%";


    const names = [
        "Very weak",
        "Weak",
        "Fair",
        "Strong",
        "Very strong"
    ];


    res.textContent =
        value
        ?
        names[Math.max(0,strength - 1)]
        + " password"
        :
        "Start typing to check strength";

}


pwd.addEventListener(
    "input",
    checkPwd
);


show.addEventListener(
    "click",
    function(){

        pwd.type =
            pwd.type === "password"
            ?
            "text"
            :
            "password";


        show.textContent =
            pwd.type === "password"
            ?
            "Show"
            :
            "Hide";

    }
);


/* =========================================================
   SCAM DETECTOR
   ========================================================= */

$("#scanBtn").addEventListener(
    "click",
    function(){

        const text =
            $("#scamText").value.toLowerCase();


        let hits = 0;


        const words = [

            "urgent",
            "otp",
            "password",
            "verify",
            "click",
            "prize",
            "winner",
            "payment",
            "refund",
            "account blocked",
            "police",
            "arrest",
            "investment",
            "fee"

        ];


        words.forEach(function(word){

            if(text.includes(word)){

                hits++;

            }

        });


        const result =
            $("#scanResult");


        result.className =
            "result show";


        if(hits >= 3){

            result.innerHTML =
                "⚠️ <b>High warning signs:</b> " +
                "The message contains several common scam patterns. " +
                "Do not share sensitive information; verify through an official channel.";

        }else if(hits){

            result.innerHTML =
                "🟡 <b>Some warning signs:</b> " +
                "Slow down and verify the sender, link and request independently.";

        }else{

            result.innerHTML =
                "🟢 <b>No obvious keyword warning found:</b> " +
                "Still verify the sender and context before taking action.";

        }

    }
);


/* =========================================================
   URL CHECKER
   ========================================================= */

$("#urlBtn").addEventListener(
    "click",
    function(){

        const value =
            $("#urlInput").value.trim();


        const result =
            $("#urlResult");


        result.className =
            "result show";


        if(!value){

            result.textContent =
                "Enter a URL first.";

            return;

        }


        try{

            const url =
                new URL(value);


            const warning =

                ![
                    "http:",
                    "https:"
                ].includes(url.protocol)

                ||

                url.hostname.includes("@")

                ||

                /\d{1,3}(\.\d{1,3}){3}/
                .test(url.hostname);


            if(warning){

                result.innerHTML =
                    "⚠️ <b>Be careful:</b> " +
                    "This URL has warning signs. " +
                    "Do not enter passwords or payment details.";

            }else{

                result.innerHTML =
                    "🟢 <b>Basic check passed:</b> " +
                    "The URL uses a normal web protocol. " +
                    "This does not guarantee that the site is safe.";

            }

        }catch(error){

            result.textContent =
                "⚠️ That does not look like a valid URL.";

        }

    }
);


/* =========================================================
   QUIZ
   ========================================================= */

const questions = [

    [
        "What should you do with an unexpected OTP request?",
        [
            "Share it",
            "Ignore/verify it",
            "Post it online",
            "Forward it"
        ],
        1
    ],

    [
        "Which password is safer?",
        [
            "password123",
            "MyName2000",
            "A long unique passphrase",
            "12345678"
        ],
        2
    ],

    [
